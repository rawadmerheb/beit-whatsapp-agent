# Anthropic (Claude) -- create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-5

# Twilio -- from your Twilio Console dashboard (console.twilio.com)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# The public HTTPS URL this app is reachable at right now (e.g. your
# cloudflared tunnel URL, or your hosting provider's URL). Needed so Twilio
# can fetch generated voice-reply audio back from you. No trailing slash.
PUBLIC_BASE_URL=https://your-tunnel-or-host.example.com

# Optional
PORT=5000
WHISPER_MODEL_SIZE=small
